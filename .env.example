# Supabase — Project Settings → API Keys (supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# This app's own trusted origin — used ONLY to build Supabase Auth email
# links (password reset, client invitation redirectTo). Server-only
# (never sent to the browser), and deliberately NEVER derived from a
# request's own Host header — see src/lib/http/currentOrigin.ts. Required
# in production; falls back to http://localhost:$PORT in development if
# unset.
# SITE_URL=https://admin.proactifsystem.fr

# Service-role key: used server-side by src/lib/supabase/admin.ts —
# required for the client-invitation and password-recovery Server Actions
# (features/hotelUsers/actions.ts, features/auth/actions.ts, both call
# admin.auth.admin.generateLink()), and by every other admin-only write in
# this codebase. Never expose to the browser (no NEXT_PUBLIC_ prefix).
# SUPABASE_SERVICE_ROLE_KEY=

# Transactional email — src/lib/email/. Used for the client-invitation and
# password-recovery emails; Supabase's own SMTP is no longer used for
# either (see supabase.auth.admin.generateLink() call sites in
# features/hotelUsers/actions.ts / features/auth/actions.ts — it generates
# the link/token but never sends anything itself).
#
# Sent via a generic SMTP provider (src/lib/email/providers/smtp.ts, using
# nodemailer) — deliberately generic names, works against any standard SMTP
# server. ALL of the values below must be set together for it to activate;
# if any is missing, sendEmail() safely resolves { ok: false, error:
# "Email provider is not configured." } without sending anything or
# throwing — see src/lib/email/provider.ts.
#
# EMAIL_SMTP_PORT determines the TLS mode deterministically: 465 = implicit
# TLS (secure:true), anything else = STARTTLS (secure:false). No automatic
# fallback between ports/modes.
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=
# Optional — defaults to "Proactif System" if unset.
# EMAIL_FROM_NAME=

# WhatsApp transport — src/lib/notifications/whatsapp/. Used to route
# partner_requests (features/partnerRequests/) to a partner's
# request_phone_e164 via the official Meta WhatsApp Business Platform /
# Cloud API. Provider-agnostic by design (see
# lib/notifications/whatsapp/provider.ts): the partner_requests domain never
# depends on graph.facebook.com directly, only on the WhatsAppProvider
# interface. ALL of the WHATSAPP_META_* values below must be set together
# (and WHATSAPP_PROVIDER must be exactly "meta") for the adapter to
# activate; if any is missing, sendPartnerRequest() safely resolves
# { ok: false, error: "provider_not_configured" } without sending anything
# or throwing — see lib/notifications/whatsapp/metaProvider.ts.
#
# Server-only: no NEXT_PUBLIC_ prefix on any of these, ever.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_APP_SECRET=
# Verify token YOU choose when configuring the webhook subscription in the
# Meta dashboard — compared against the `hub.verify_token` query param Meta
# sends on the GET verification handshake (lib/notifications/whatsapp/webhook.ts).
# WHATSAPP_META_VERIFY_TOKEN=
# e.g. v21.0 — see developers.facebook.com/docs/graph-api/changelog.
# WHATSAPP_META_API_VERSION=
# Name of the Meta-approved template used for the FIRST outbound message to
# a partner (no open 24h conversation window can be assumed) — see
# lib/notifications/whatsapp/sendPartnerRequest.ts's own doc comment. Left
# unset until a real template exists and is approved by Meta; sendPartnerRequest()
# then safely resolves { ok: false, error: "template_not_configured" }.
# WHATSAPP_PARTNER_REQUEST_TEMPLATE=

# OpenAI — platform.openai.com/api-keys. Server-only (no NEXT_PUBLIC_
# prefix): never sent to the browser, never logged. Required for the Jalon 2
# RAG engine (features/rag/, /api/hotels/[id]/chat).
OPENAI_API_KEY=
# Chat model for the Responses API — no default on purpose, set explicitly.
OPENAI_CHAT_MODEL=
# Embedding model — defaults to text-embedding-3-small if unset. Changing
# this to a model with a different native dimension requires a new Supabase
# migration (the knowledge_chunks.embedding column is a fixed vector(1536)).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
